# RÚNA runtime configuration.
#
# Installed to /etc/runa/runa.env. Edit here, then:
#   sudo systemctl restart runa
#
# Rooms live only in RAM, so every limit below is a ceiling on how much of
# the host a stranger can claim. The worst case has a closed form:
#
#   peak ~= 25 MB baseline
#         + 1.4 x RUNA_MAX_TOTAL_LOG_MB      (entry records + allocator slack)
#         + RUNA_MAX_CONNECTIONS x RUNA_MAX_QUEUE_KB
#         + ~32 MB rate-limiter tables, fully saturated
#
# The values below work out to ~1549 MB, which is why the unit sets
# MemoryMax=2G. If you raise these, raise MemoryMax in step — otherwise the
# cgroup kills the process and every live document dies with it.

# ── Placement ────────────────────────────────────────────────────────────
# Loopback only. The Dockerfile's 0.0.0.0 default is correct inside a
# container and wrong for a host process behind a reverse proxy.
RUNA_BIND=127.0.0.1:3000
RUNA_DIST=/opt/runa/dist

# Required behind Caddy. Without it every visitor arrives from the loopback
# address and all per-IP limits collapse into one shared bucket, so a
# handful of visitors use up the limit and everyone after them is refused. Reads the rightmost
# X-Forwarded-For entry — the only one the proxy itself wrote.
RUNA_TRUSTED_PROXY=1

RUST_LOG=runa_server=info

# ── Resource ceiling. Keep in step with MemoryMax in runa.service. ───────
RUNA_MAX_TOTAL_LOG_MB=700
RUNA_MAX_ROOMS=512
RUNA_MAX_PEERS=32
RUNA_MAX_CONNECTIONS=512
RUNA_MAX_QUEUE_KB=1024

# Concurrent WebSockets one address may hold. Offices, schools and mobile
# carriers put many people behind one address. Defaults to 64, or a quarter of
# RUNA_MAX_CONNECTIONS if that is lower.
RUNA_MAX_CONNS_PER_IP=64

# ── Restarts ─────────────────────────────────────────────────────────────
# On stop, every open room is shown a countdown of this many seconds before
# the process exits; with nobody connected it exits at once. Keep it below
# TimeoutStopSec in runa.service.
RUNA_SHUTDOWN_GRACE_SECS=60
#
# Rooms live only in memory. What carries them across a restart is
# RUNA_RESTART_KEY: the stopping process hands every member a ticket signed
# with it, and the starting one — holding the same key — lets them bring the
# room back from their own copies. It is a secret, so it is not in this file:
# deploy-oracle.sh generates it once into /etc/runa/restart.env (root, 0600),
# and never rotates it, since tickets signed under an old key cannot be read
# under a new one. Delete that file to turn the handover off.

# ── Onion service ────────────────────────────────────────────────────────
# Written by `RUNA_ONION=1 ./scripts/deploy-oracle.sh`, which also sets up tor.
# RUNA_ONION_BIND is a second, loopback-only listener that only the local tor
# daemon reaches; it treats each Tor circuit as its own client and believes no
# forwarded-for header. RUNA_ONION_URL is advertised to Tor Browser on the
# clearnet pages as Onion-Location.
# RUNA_ONION_BIND=127.0.0.1:3080
# RUNA_ONION_URL=http://<56 characters>.onion

# ── Deliberately unset ───────────────────────────────────────────────────
# RUNA_ALLOW_INSECURE        permits plain ws://. Never set this in production.
# RUNA_ALLOW_CEILING_OPTOUT  lets any anonymous caller create a room that
#                            never expires — a permanent memory reservation.
