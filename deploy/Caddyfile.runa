# Append to /etc/caddy/Caddyfile, after the existing site blocks.
# Leave the global { log { output discard } } block where it is.
#
# The request path carries the room id. The key itself never leaves the
# browser — it lives in the URL fragment — but the path still reveals which
# rooms exist and when they are opened, so it is not written to disk.
runa.example.com {
	log {
		output discard
	}
	tls {
		protocols tls1.3 tls1.3
	}
	# Caddy upgrades WebSockets through reverse_proxy automatically.
	reverse_proxy 127.0.0.1:3000
}
