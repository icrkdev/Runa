[Unit]
Description=RUNA - ephemeral E2EE collaborative markdown
Documentation=https://github.com/icrkdev/Runa
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
DynamicUser=yes
ExecStart=/usr/local/bin/runa-server
EnvironmentFile=/etc/runa/runa.env

# ── Hardening ────────────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Without this a syscall outside @system-service kills the process with
# SIGSYS. RUNA calls mlockall(2) at startup and already tolerates its
# failure; this makes a filtered call return an error instead of a corpse.
SystemCallErrorNumber=EPERM

# ── Limits. MemoryMax must stay in step with runa.env. ───────────────────
# MemoryHigh throttles and reclaims first; MemoryMax kills. A throttled
# RUNA is recoverable, a killed one has destroyed every live room.
MemoryHigh=1700M
MemoryMax=2G
TasksMax=256
LimitNOFILE=16384
# Lets mlockall(2) actually succeed, which is what keeps room ciphertext and
# the room verifier out of swap. Unprivileged processes may lock memory up to
# RLIMIT_MEMLOCK, so no capability is needed — and MemoryMax still bounds the
# total, so this cannot be used to exhaust the host. Without it the call fails
# with ENOMEM and the no-swap guarantee is not real.
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=2
# On stop, RUNA warns every open room and waits RUNA_SHUTDOWN_GRACE_SECS (60 s
# by default) so people can export before their room ends. This has to be
# longer, or systemd kills the process in the middle of that warning.
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
